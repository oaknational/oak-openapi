{
  "name": "oak-openapi",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.6.0 <21",
    "pnpm": ">=8"
  },
  "scripts": {
    "build": "next build",
    "build-subjects": "tsx bin/build-subjects-and-key-stages.ts",
    "dev": "pnpm with-env next dev --port 2727",
    "bulk": "NODE_OPTIONS='--max-old-space-size=4096' tsx bin/prepare-bulk.ts",
    "postinstall": "prisma generate --schema ./schema.prisma",
    "format:check": "prettier '**/*.{j,t}{s,sx}' --check",
    "format": "prettier '**/*.{j,t}{s,sx}' --write",
    "lint": "next lint .",
    "load-test": "pnpm with-env artillery run __tests__/load-tests.yml",
    "prepare": "husky",
    "test": "pnpm with-env vitest",
    "test:vscode": "pnpm with-env vitest --no-file-parallelism --test-timeout=0",
    "with-env": "dotenv -e ./.env --",
    "generate:openapi": "node scripts/addExamplesToZodSchema.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "@next/eslint-plugin-next": "^15.3.3",
    "@oaknational/oak-components": "^1.111.1",
    "@oaknational/oak-curriculum-schema": "^1.39.0",
    "@prisma/client": "^5.22.0",
    "@prisma/extension-accelerate": "^1.1.0",
    "@trpc/server": "^11.1.2",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.30.0",
    "cors": "^2.8.5",
    "graphql-request": "^6.1.0",
    "http-codes": "^1.0.0",
    "lodash": "^4.17.21",
    "next": "^15.3.2",
    "object.groupby": "^1.0.3",
    "openapi-types": "^12.1.3",
    "pg": "^8.14.0",
    "posthog-js": "^1.172.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "renvy": "^4.0.2",
    "slugify": "^1.6.6",
    "styled-components": "^6.1.18",
    "superjson": "^2.2.1",
    "swagger-ui-react": "^5.15.2",
    "tar-stream": "^3.1.7",
    "trpc-to-openapi": "2.1.5",
    "uuid": "^10.0.0",
    "zod": "^3.22.4",
    "zod-openapi": "^4.2.4"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/generator": "^7.27.5",
    "@babel/parser": "^7.27.5",
    "@babel/traverse": "^7.27.4",
    "@babel/types": "^7.27.3",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/types": "^19.5.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.20.7",
    "@types/cors": "^2.8.17",
    "@types/http-codes": "^1.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/lodash": "^4.17.15",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/styled-components": "^5.1.34",
    "@types/swagger-ui-react": "^4.18.3",
    "@types/tar-stream": "^3.1.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vitest/coverage-v8": "^3.0.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "array.prototype.tosorted": "^1.1.3",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.38",
    "prettier": "^3.4.1",
    "prettier-plugin-embed": "^0.4.15",
    "prisma": "^5.21.1",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.12",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.0",
    "webpack-bugsnag-plugins": "^1.8.0"
  },
  "prettier": {
    "singleQuote": true
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "next lint ."
    ]
  }
}
