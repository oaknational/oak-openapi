{
  "name": "oak-openapi",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.6.0 <21",
    "pnpm": ">=8"
  },
  "scripts": {
    "build": "next build",
    "build-subjects": "tsx bin/build-subjects-and-key-stages.ts",
    "dev": "pnpm with-env next dev --port 2727",
    "format:check": "prettier '**/*.{j,t}{s,sx}' --check",
    "format": "prettier '**/*.{j,t}{s,sx}' --write",
    "generate-prisma": "pnpm with-env prisma generate",
    "lint": "next lint .",
    "load-test": "pnpm with-env artillery run __tests__/load-tests.yml",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "test": "pnpm with-env vitest",
    "test:vscode": "pnpm with-env vitest --no-file-parallelism --test-timeout=0",
    "with-env": "dotenv -e ./.env --"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "@oaknational/oak-components": "^1.41.0",
    "@oaknational/oak-curriculum-schema": "^1.39.0",
    "@prisma/client": "^5.21.1",
    "@prisma/extension-accelerate": "^1.1.0",
    "@trpc/server": "10.45.2",
    "@upstash/ratelimit": "^1.2.1",
    "@upstash/redis": "^1.30.0",
    "cors": "^2.8.5",
    "graphql-request": "^6.1.0",
    "next": "^14.2.1",
    "object.groupby": "^1.0.3",
    "openapi-types": "^12.1.3",
    "posthog-js": "^1.172.0",
    "renvy": "^4.0.2",
    "slugify": "^1.6.6",
    "styled-components": "^6.1.12",
    "superjson": "^2.2.1",
    "swagger-ui-react": "^5.15.2",
    "trpc-openapi": "^1.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/types": "^19.5.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/styled-components": "^5.1.34",
    "@types/swagger-ui-react": "^4.18.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@vitest/coverage-v8": "^3.0.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "array.prototype.tosorted": "^1.1.3",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.38",
    "prettier": "^3.4.1",
    "prettier-plugin-embed": "^0.4.15",
    "prisma": "^5.21.1",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.12",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.0",
    "webpack-bugsnag-plugins": "^1.8.0"
  },
  "prettier": {
    "singleQuote": true
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "next lint ."
    ]
  }
}
