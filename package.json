{
  "name": "oak-openapi",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.20.0 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "next build",
    "build-subjects": "tsx bin/build-subjects-and-key-stages.ts",
    "dev": "pnpm with-env next dev --port 2727",
    "bulk": "NODE_OPTIONS='--max-old-space-size=4096' tsx bin/prepare-bulk.ts",
    "postinstall": "prisma generate --schema ./schema.prisma",
    "format:check": "prettier '**/*.{mj,j,t}{s,sx}' --check",
    "format": "prettier '**/*.{mj,j,t}{s,sx}' --write",
    "lint": "next lint .",
    "load-test": "pnpm with-env artillery run __tests__/load-tests.yml",
    "prepare": "husky",
    "test": "prisma generate --no-engine; pnpm with-env vitest",
    "test:vscode": "pnpm with-env vitest --no-file-parallelism --test-timeout=0",
    "with-env": "dotenv -e ./.env --",
    "generate:openapi": "node bin/zod-openapi-schema-gen/addExamplesToZodSchema.mjs",
    "test:all": "pnpm -r test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:static-serve": "storybook build --quiet && http-server ./storybook-static --port=6006",
    "gen-zod-from-gql": "tsx bin/zod-from-gql.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
