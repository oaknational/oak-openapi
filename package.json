{
  "name": "oak-openapi",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.6.0 <21",
    "pnpm": ">=8"
  },
  "scripts": {
    "dev": "pnpm with-env next dev --port 2727",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "with-env": "dotenv -e ./.env --",
    "build": "next build",
    "test": "pnpm with-env vitest",
    "load-test": "pnpm with-env artillery run __tests__/load-tests.yml",
    "generate-prisma": "pnpm with-env prisma generate",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@oaknational/oak-components": "^1.13.0",
    "@prisma/client": "^5.14.0",
    "@prisma/extension-accelerate": "^1.1.0",
    "@trpc/server": "^10.45.2",
    "@upstash/ratelimit": "^1.2.1",
    "@upstash/redis": "^1.30.0",
    "cors": "^2.8.5",
    "graphql-request": "^6.1.0",
    "next": "^14.2.1",
    "object.groupby": "^1.0.3",
    "openapi-types": "^12.1.3",
    "posthog-js": "^1.172.0",
    "styled-components": "^6.1.12",
    "superjson": "^2.2.1",
    "swagger-ui-react": "^5.15.2",
    "trpc-openapi": "^1.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/styled-components": "^5.1.34",
    "@types/swagger-ui-react": "^4.18.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "array.prototype.tosorted": "^1.1.3",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.1",
    "postcss": "^8.4.38",
    "prettier": "^3.3.3",
    "prisma": "^5.14.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.12",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.0",
    "webpack-bugsnag-plugins": "^1.8.0"
  }
