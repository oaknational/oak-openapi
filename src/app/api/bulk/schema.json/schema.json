{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oak Curriculum API Bulk Export Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequenceSlug", "subjectTitle", "sequence", "lessons"],
  "properties": {
    "sequenceSlug": {
      "type": "string",
      "description": "Slug for the subject sequence collection (e.g., 'french-primary')."
    },
    "subjectTitle": {
      "type": "string",
      "enum": [
        "Art and design",
        "Citizenship",
        "Computing",
        "Cooking and nutrition",
        "Design and technology",
        "English",
        "French",
        "Geography",
        "German",
        "History",
        "Maths",
        "Music",
        "Physical education",
        "RSHE (PSHE)",
        "Religious education",
        "Science",
        "Biology",
        "Chemistry",
        "Physics",
        "Combined science",
        "Spanish"
      ],
      "description": "Human-readable subject title (e.g., 'French')."
    },
    "sequence": {
      "type": "array",
      "description": "Ordered list of units for the subject sequence.",
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "ks4Options": {
      "type": "array",
      "description": "Available KS4 options for the subject (e.g., exam boards or pathways).",
      "items": {
        "$ref": "#/$defs/ks4Option"
      }
    },
    "lessons": {
      "type": "array",
      "description": "Published lessons available for the subject, across units (unitLessons with state != 'published' are excluded).",
      "items": {
        "$ref": "#/$defs/lesson"
      }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitSlug",
        "unitTitle",
        "threads",
        "priorKnowledgeRequirements",
        "nationalCurriculumContent",
        "description",
        "yearSlug",
        "year",
        "keyStageSlug",
        "whyThisWhyNow",
        "unitLessons"
      ],
      "properties": {
        "unitSlug": {
          "type": "string",
          "description": "Slug identifier for the unit."
        },
        "unitTitle": {
          "type": "string",
          "description": "Human-readable unit title."
        },
        "threads": {
          "type": "array",
          "description": "Thread tags that categorize unit content.",
          "items": {
            "$ref": "#/$defs/thread"
          }
        },
        "examBoards": {
          "type": "array",
          "description": "Exam boards applicable to the unit (typically secondary).",
          "items": {
            "$ref": "#/$defs/examBoard"
          }
        },
        "priorKnowledgeRequirements": {
          "type": "array",
          "description": "Prior knowledge statements required for the unit.",
          "items": {
            "type": "string"
          }
        },
        "nationalCurriculumContent": {
          "type": "array",
          "description": "National curriculum references covered by the unit.",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "description": "Narrative description of the unit."
        },
        "yearSlug": {
          "type": "string",
          "enum": [
            "reception",
            "year-1",
            "year-2",
            "year-3",
            "year-4",
            "year-5",
            "year-6",
            "year-7",
            "year-8",
            "year-9",
            "year-10",
            "year-11",
            "year-12",
            "year-13",
            "all-years"
          ],
          "description": "Slug for the academic year or band."
        },
        "year": {
          "type": "integer",
          "description": "Numeric academic year."
        },
        "keyStageSlug": {
          "type": "string",
          "enum": [
            "ks1",
            "ks2",
            "ks3",
            "ks4",
            "early-years-foundation-stage",
            "all-ks"
          ],
          "description": "Key stage slug for the unit."
        },
        "whyThisWhyNow": {
          "type": "string",
          "description": "Rationale for sequence timing and unit placement."
        },
        "unitLessons": {
          "type": "array",
          "description": "Lessons that belong to the unit in teaching order.",
          "items": {
            "$ref": "#/$defs/unitLesson"
          }
        }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "order", "title"],
      "properties": {
        "slug": {
          "type": "string",
          "description": "Thread slug identifier."
        },
        "order": {
          "type": "integer",
          "description": "Display/order index for the thread."
        },
        "title": {
          "type": "string",
          "description": "Human-readable thread title."
        }
      }
    },
    "unitLesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lessonSlug", "lessonTitle", "lessonOrder", "state"],
      "properties": {
        "lessonSlug": {
          "type": "string",
          "description": "Slug identifier for the lesson (must exist in lessons[] when state is 'published')."
        },
        "lessonTitle": {
          "type": "string",
          "description": "Human-readable lesson title."
        },
        "lessonOrder": {
          "type": "integer",
          "description": "Order of the lesson within the unit."
        },
        "state": {
          "type": "string",
          "enum": ["published", "new", "migration"],
          "description": "Publication state for the lesson (only 'published' lessons appear in lessons[])."
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessonTitle",
        "lessonSlug",
        "unitSlug",
        "unitTitle",
        "subjectSlug",
        "subjectTitle",
        "keyStageSlug",
        "keyStageTitle",
        "lessonKeywords",
        "keyLearningPoints",
        "misconceptionsAndCommonMistakes",
        "pupilLessonOutcome",
        "teacherTips",
        "contentGuidance",
        "downloadsavailable",
        "supervisionLevel",
        "transcript_sentences",
        "transcript_vtt"
      ],
      "properties": {
        "lessonTitle": {
          "type": "string",
          "description": "Human-readable lesson title."
        },
        "lessonSlug": {
          "type": "string",
          "description": "Slug identifier for the lesson."
        },
        "unitSlug": {
          "type": "string",
          "description": "Slug identifier of the unit this lesson belongs to."
        },
        "unitTitle": {
          "type": "string",
          "description": "Title of the unit this lesson belongs to."
        },
        "subjectSlug": {
          "type": "string",
          "enum": [
            "art",
            "citizenship",
            "computing",
            "cooking-nutrition",
            "design-technology",
            "english",
            "french",
            "geography",
            "german",
            "history",
            "maths",
            "music",
            "physical-education",
            "religious-education",
            "rshe-pshe",
            "science",
            "biology",
            "chemistry",
            "physics",
            "combined-science",
            "spanish"
          ],
          "description": "Subject slug for the lesson."
        },
        "subjectTitle": {
          "type": "string",
          "enum": [
            "Art and design",
            "Citizenship",
            "Computing",
            "Cooking and nutrition",
            "Design and technology",
            "English",
            "French",
            "Geography",
            "German",
            "History",
            "Maths",
            "Music",
            "Physical education",
            "RSHE (PSHE)",
            "Religious education",
            "Science",
            "Biology",
            "Chemistry",
            "Physics",
            "Combined science",
            "Spanish"
          ],
          "description": "Subject title for the lesson."
        },
        "keyStageSlug": {
          "type": "string",
          "enum": [
            "ks1",
            "ks2",
            "ks3",
            "ks4",
            "early-years-foundation-stage",
            "all-ks"
          ],
          "description": "Key stage slug for the lesson."
        },
        "keyStageTitle": {
          "type": "string",
          "enum": [
            "Key Stage 1",
            "Key Stage 2",
            "Key Stage 3",
            "Key Stage 4",
            "Early Years Foundation Stage",
            "All Key Stages"
          ],
          "description": "Key stage title for the lesson."
        },
        "lessonKeywords": {
          "type": "array",
          "description": "Keywords used to index or describe the lesson.",
          "items": {
            "$ref": "#/$defs/lessonKeyword"
          }
        },
        "keyLearningPoints": {
          "type": "array",
          "description": "Key learning points for the lesson.",
          "items": {
            "$ref": "#/$defs/keyLearningPoint"
          }
        },
        "misconceptionsAndCommonMistakes": {
          "type": "array",
          "description": "Common misconceptions and guidance responses.",
          "items": {
            "$ref": "#/$defs/misconception"
          }
        },
        "pupilLessonOutcome": {
          "type": "string",
          "description": "Expected lesson outcome for pupils."
        },
        "teacherTips": {
          "type": "array",
          "description": "Tips and guidance for teachers.",
          "items": {
            "$ref": "#/$defs/teacherTip"
          }
        },
        "contentGuidance": {
          "type": ["array", "null"],
          "description": "Additional content guidance; may be null when not provided.",
          "items": {
            "$ref": "#/$defs/contentGuidanceItem"
          }
        },
        "downloadsavailable": {
          "type": "boolean",
          "description": "Whether downloads are available for the lesson."
        },
        "supervisionLevel": {
          "type": ["string", "null"],
          "description": "Supervision requirement; may be null when not provided."
        },
        "transcript_sentences": {
          "type": ["string", "null"],
          "description": "Transcript in sentence form; may be null when not provided."
        },
        "transcript_vtt": {
          "type": ["string", "null"],
          "description": "Transcript in VTT format; may be null when not provided."
        }
      }
    },
    "lessonKeyword": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyword", "description"],
      "properties": {
        "keyword": {
          "type": "string",
          "description": "Keyword text."
        },
        "description": {
          "type": "string",
          "description": "Keyword definition or explanation."
        }
      }
    },
    "keyLearningPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyLearningPoint"],
      "properties": {
        "keyLearningPoint": {
          "type": "string",
          "description": "A single key learning point statement."
        }
      }
    },
    "misconception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["misconception", "response"],
      "properties": {
        "misconception": {
          "type": "string",
          "description": "Misconception statement."
        },
        "response": {
          "type": "string",
          "description": "Recommended response to address the misconception."
        }
      }
    },
    "teacherTip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teacherTip"],
      "properties": {
        "teacherTip": {
          "type": "string",
          "description": "Tip or guidance for teachers."
        }
      }
    },
    "contentGuidanceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentGuidanceArea",
        "supervisionlevel_id",
        "contentGuidanceLabel",
        "contentGuidanceDescription"
      ],
      "properties": {
        "contentGuidanceArea": {
          "type": "string",
          "description": "Content guidance area."
        },
        "supervisionlevel_id": {
          "type": "integer",
          "description": "Supervision level identifier."
        },
        "contentGuidanceLabel": {
          "type": "string",
          "description": "Content guidance label."
        },
        "contentGuidanceDescription": {
          "type": "string",
          "description": "Content guidance description."
        }
      }
    },
    "examBoard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title"],
      "properties": {
        "slug": {
          "type": "string",
          "enum": ["aqa", "edexcel", "eduqas", "ocr", "wjec", "edexcelb"],
          "description": "Exam board slug."
        },
        "title": {
          "type": "string",
          "enum": ["AQA", "Edexcel", "Eduqas", "OCR", "WJEC", "Edexcel B"],
          "description": "Exam board title."
        }
      }
    },
    "ks4Option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title"],
      "properties": {
        "slug": {
          "type": "string",
          "enum": [
            "aqa",
            "edexcel",
            "eduqas",
            "ocr",
            "wjec",
            "edexcelb",
            "core",
            "gcse"
          ],
          "description": "KS4 option slug (exam board or pathway)."
        },
        "title": {
          "type": "string",
          "enum": [
            "AQA",
            "Edexcel",
            "Eduqas",
            "OCR",
            "WJEC",
            "Edexcel B",
            "Core",
            "GCSE"
          ],
          "description": "KS4 option title (exam board or pathway)."
        }
      }
    }
  },
  "$comment": "TODO: Add validation logic outside JSON Schema to enforce referential integrity between unitLessons[].lessonSlug and lessons[].lessonSlug when unitLessons[].state == 'published', and between lessons[].unitSlug and sequence[].unitSlug."
}
